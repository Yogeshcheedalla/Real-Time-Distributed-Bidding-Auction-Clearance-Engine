# BidVelocity — local environment contract.
# Copy to .env (git-ignored) and fill in YOUR local values.
# NEVER commit real secrets. NEVER paste secrets into chat — edit this file locally.

# --- PostgreSQL (local Windows installation, single server, four service-owned databases) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me-locally

# --- JWT (generate: powershell -c "[convert::tosecurestring((-join((48..122|get-random -count 48|%{[char]$_})))) -as [system.management.automation.pscoredforsafehandlestring]].UnprotectSafeString()") ---
# Use any random string of >= 32 characters; keep it secret.
JWT_SECRET=change-me-random-32-plus-chars
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=14

# --- Google OAuth2 (Google Cloud Console → OAuth client, Web application) ---
# Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI:      http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-never-sent-to-frontend

# --- Redis (optional local infrastructure; not required for core flows in Phase 4) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka (optional event transport; falls back to in-process events when absent) ---
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
GATEWAY_URL=http://localhost:8080
